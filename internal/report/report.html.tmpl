<!doctype html>
<html lang="{{t .Lang "h.lang"}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{t .Lang "h.title" .Label}}</title>
<style>
:root { --bg:#f6f8fb; --card:#fff; --ink:#12355B; --muted:#5b6b7f; --line:#dde4ec;
  --high:#c62828; --medium:#b26a00; --low:#1565c0; --info:#607080; --ok:#2e7d32; --accent:#F59E0B; }
@media (prefers-color-scheme: dark) { :root { --bg:#0f1720; --card:#17212c; --ink:#e3ebf3; --muted:#93a4b6;
  --line:#2a3846; --high:#ef5350; --medium:#ffb74d; --low:#64b5f6; --info:#90a4ae; --ok:#81c784; } }
* { box-sizing:border-box; }
body { margin:0; background:var(--bg); color:var(--ink); font:15px/1.5 system-ui,-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif; }
main { max-width:960px; margin:0 auto; padding:24px 16px 48px; }
h1 { margin:0 0 4px; font-size:24px; } h1 span { color:var(--accent); }
h2 { font-size:18px; margin:0 0 8px; } .muted { color:var(--muted); } .small { font-size:13px; }
.card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:16px; margin:16px 0; }
table { width:100%; border-collapse:collapse; font-size:14px; } th,td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--line); vertical-align:top; }
th { color:var(--muted); font-weight:600; } code { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:13px; word-break:break-all; }
.badge { display:inline-block; min-width:62px; text-align:center; border-radius:999px; padding:1px 8px; font-size:12px; font-weight:700; color:#fff; }
.high { background:var(--high); } .medium { background:var(--medium); } .low { background:var(--low); } .info,.none { background:var(--info); }
.finding { border-left:4px solid var(--line); padding:8px 12px; margin:10px 0; }
.finding.f-high { border-color:var(--high); } .finding.f-medium { border-color:var(--medium); } .finding.f-low { border-color:var(--low); }
.finding p { margin:4px 0; } .k { color:var(--muted); display:inline-block; min-width:72px; }
.new { color:var(--high); font-weight:700; } .gone { color:var(--ok); } .warn { color:var(--medium); }
footer { margin-top:24px; font-size:13px; color:var(--muted); }
.scroll { overflow-x:auto; }
</style>
</head>
<body><main>
<h1>Wan<span>Hound</span> {{t .Lang "h.heading" .Label}}</h1>
<div class="muted">{{when .Started}} · {{t .Lang "h.took" (dur .Duration)}} · {{t .Lang "h.rules" .RulesVersion}}</div>

{{range .Errors}}<div class="card"><h2 class="warn">{{t $.Lang "r.not_audited" .IP}}</h2><p>{{render .Reason $.Lang}}</p></div>{{end}}

{{range .Targets}}
<div class="card">
  <h2>{{.IP}} <span class="muted small">IP{{.Family}}</span> <span class="badge {{maxrisk .Findings}}">{{upper (t $.Lang (printf "risk.%s" (maxrisk .Findings)))}}</span></h2>
  {{with .Intel}}<div class="muted small">{{.ASN}} {{.Org}} {{.Country}}{{range .PTR}} · {{t $.Lang "r.ptr" .}}{{end}}{{if .Source}} · {{t $.Lang "r.via" .Source}}{{end}}</div>
  {{range .Hints}}<p class="warn small">! {{render . $.Lang}}</p>{{end}}{{end}}
  <p><b>{{.Counts.Open}}</b> {{t $.Lang "h.open"}} · {{.Counts.Closed}} {{t $.Lang "h.closed"}} · {{.Counts.Filtered}} {{t $.Lang "h.filtered"}} — {{t $.Lang "h.scan" (t $.Lang (printf "portset.%s" .PortSet)) (ms .Timeout)}}</p>
  {{with .Changes}}
    <p class="small">{{t $.Lang "h.compared" (when .PrevTime) .PrevIP}}
    {{if .IPChanged}}<span class="warn">{{t $.Lang "h.addr_changed"}}</span>{{end}}
    {{if .Opened}}<span class="new">{{t $.Lang "h.new" (ints .Opened)}}</span>{{end}}
    {{if .UDPOpened}}<span class="new">{{t $.Lang "h.new_udp" (ints .UDPOpened)}}</span>{{end}}
    {{if .Closed}}<span class="gone">{{t $.Lang "h.gone" (ints .Closed)}}</span>{{end}}
    {{range .Changed}}<br>{{t $.Lang "h.changed" .Port}} <code>{{.Before}}</code> → <code>{{.After}}</code>{{end}}
    {{if .Empty}}<br>{{t $.Lang "h.no_change"}}{{end}}
    {{with .Coverage}}<br><span class="muted">{{render . $.Lang}}</span>{{end}}</p>
  {{else}}<p class="small muted">{{t $.Lang "h.baseline"}}</p>{{end}}

  {{if .Open}}<div class="scroll"><table>
    <tr><th>{{t $.Lang "h.port"}}</th><th>{{t $.Lang "h.ident"}}</th></tr>
    {{range .Open}}<tr><td>{{.Port}}/tcp</td><td><code>{{.Evidence}}</code></td></tr>{{end}}
  </table></div>{{end}}
  {{if .UDP}}<p class="small muted">{{t $.Lang "h.udp"}} {{range $i, $u := .UDP}}{{if $i}} · {{end}}{{$u.Port}} {{t $.Lang (printf "udp.%s" $u.State.String)}}{{end}}</p>{{end}}

  {{range .Findings}}
  <div class="finding f-{{risk .Risk}}">
    <p><span class="badge {{risk .Risk}}">{{upper (t $.Lang (printf "risk.%s" (risk .Risk)))}}</span> <b>{{where . $.Lang}}</b> — <b>{{.Title}}</b> <span class="muted small">{{.RuleID}}{{if .Confidence}}{{t $.Lang "r.confidence" (t $.Lang (printf "conf.%s" .Confidence))}}{{end}}</span></p>
    {{if .Evidence}}<p class="small"><span class="k">{{t $.Lang "h.evidence"}}</span><code>{{.Evidence}}</code></p>{{end}}
    <p><span class="k">{{t $.Lang "h.what"}}</span>{{.Explain}}</p>
    <p><span class="k">{{t $.Lang "h.do"}}</span>{{.Advice}}</p>
  </div>
  {{else}}<p class="gone">{{t $.Lang "r.nothing"}}</p>{{end}}

  {{if .Notes}}<ul class="small muted">{{range .Notes}}<li>{{render . $.Lang}}</li>{{end}}</ul>{{end}}
  <p class="small muted">{{t $.Lang "h.source" (egress . $.Offline $.Lang) (spec .Scanned $.Lang) .ID}}</p>
</div>
{{end}}
<footer>{{t .Lang "h.footer"}}</footer>
</main></body></html>
